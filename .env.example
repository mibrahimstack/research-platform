# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to Git.

# --- Neo4j AuraDB (free tier) ---
# Get these after creating a free instance at https://neo4j.com/cloud/aura-free/
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# --- Postgres (Neon or Supabase free tier) ---
# Get this connection string from your Neon/Supabase project dashboard
POSTGRES_URL=postgresql://user:password@host:5432/dbname

# --- Groq API (free tier) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
